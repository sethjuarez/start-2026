        "narrative": false,
        "demo_actions": false,
        "screenshot": false,
        "visual": false,
        "design_plan": false
      },
      "time": "~15s",
      "narrative": "- We also have operational telemetry built into the application.",
      "demo_actions": "Transition from run traceability into the telemetry or analytics view.",
      "screenshot": ".cutready/screenshots/20260617_111509_CleanShot 2026-06-17 at 11.14.49@2x.png"
    },
