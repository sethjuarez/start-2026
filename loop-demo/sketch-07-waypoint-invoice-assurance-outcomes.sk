      "locks": {
        "time": false,
        "narrative": false,
        "demo_actions": false,
        "screenshot": false,
        "visual": false,
        "design_plan": false
      },
      "time": "~15s",
      "narrative": "- Now let's switch over to the run history.",
      "demo_actions": "Move from the invoice detail view into the run history page or panel.",
      "screenshot": ".cutready/screenshots/20260617_111427_CleanShot 2026-06-17 at 11.14.06@2x.png"
    },
    {
      "locked": false,
      "locks": {
        "time": false,
        "narrative": false,
        "demo_actions": false,
        "screenshot": false,
        "visual": false,
        "design_plan": false
      },
      "time": "~30s",
      "narrative": "- Here we can see every execution across the system.\n- We can filter by date range, decision type, confidence level, or even sort by the amount of money at risk to quickly identify the highest priority cases.",
      "demo_actions": "In run history, show the full list of executions and demonstrate filters for date range, decision type, confidence, and financial risk.",
      "screenshot": null
    },
    {
      "locked": false,
      "locks": {
        "time": false,
        "narrative": false,
        "demo_actions": false,
        "screenshot": false,
        "visual": false,
        "design_plan": false
      },
      "time": "~35s",
      "narrative": "- If we open one of these runs, we get a complete view of how that decision was made.\n- In this example, the invoice represents $920 of potential risk.\n- We can see each service involved in the workflow, including FoundryIQ and FabricIQ, along with an aggregator agent that combines those results into a single recommendation that our Waypoint application ultimately presents to the reviewer.",
      "demo_actions": "Open a specific run and walk through the detailed trace. Point out FoundryIQ, FabricIQ, and the aggregator agent that produces the final recommendation.",
      "screenshot": null
    },
    {
      "locked": false,
      "locks": {
        "time": false,
        "narrative": false,
        "demo_actions": false,
        "screenshot": false,
        "visual": false,
        "design_plan": false
      },
      "time": "~20s",
      "narrative": "- Because every step is captured, the entire process is fully traceable from the original documents all the way to the final recommendation.",
      "demo_actions": "Pause on the trace view and reinforce the end-to-end traceability from source material to recommendation.",
      "screenshot": null
    },
    {
      "locked": false,
      "locks": {
